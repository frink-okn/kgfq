{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgf.okn.us/schemas/kgfq.receipt/1",
  "title": "kgfq receipt (C6, D5, D17)",
  "description": "Attached to every table as a sidecar and in the Parquet footer under `kgfq.receipt`. What makes an approximate answer a finding rather than a bug.",
  "type": "object",
  "required": ["schema", "kind", "grade", "created"],
  "properties": {
    "schema": {"const": "kgfq.receipt/1"},
    "kind": {"enum": ["fetch", "hydrate", "labels", "derived", "import", "resolve"]},
    "step": {"type": ["integer", "null"], "description": "The log step that produced the table."},
    "grade": {"enum": ["bundle", "sparql", "external", "asserted"], "description": "D17 source grade; a derived table takes the minimum over its inputs."},
    "source": {
      "type": "object",
      "description": "For grade `bundle`: the graph at its pinned release and the origin it was fetched from.",
      "required": ["origin", "dataset", "version", "content_digest"],
      "properties": {
        "grade": {"type": "string"},
        "origin": {"type": "string"},
        "dataset": {"type": "string"},
        "dataset_iri": {"type": ["string", "null"]},
        "version": {"type": "string"},
        "content_digest": {"type": "string"}
      }
    },
    "intent": {"type": "object"},
    "plan": {"type": ["object", "null"], "description": "The kgfq.plan/1 document that was executed."},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "url", "status"],
        "properties": {
          "request_id": {"type": ["string", "null"], "description": "The server's KGF-Request-Id, for the access-log census."},
          "method": {"type": "string"}, "url": {"type": "string"}, "status": {"type": "integer"},
          "bytes_wire": {"type": "integer"}, "bytes_decoded": {"type": "integer"}, "elapsed_ms": {"type": "number"},
          "complete": {"type": ["boolean", "null"]}, "truncation_reason": {"type": ["string", "null"]},
          "bindings": {"type": ["integer", "null"]}, "rows": {"type": ["integer", "null"]}
        }
      }
    },
    "totals": {"type": "object", "properties": {"requests": {"type": "integer"}, "bytes_wire": {"type": "integer"}, "bytes_decoded": {"type": "integer"}, "elapsed_ms": {"type": "number"}}},
    "completeness": {"type": "object", "properties": {"complete": {"type": "boolean"}, "truncation_reasons": {"type": "array", "items": {"type": "string"}}}},
    "approximations": {"type": "array", "items": {"type": "string"}, "description": "Every approximation made, in words (R3 limit pushdown, etc.)."},
    "inputs": {"type": "object", "description": "Each input classified derived/asserted/external (see log-record.schema.json).", "additionalProperties": {"type": "object"}},
    "statement": {"type": "string", "description": "For kind `derived`: the SQL that produced the table."},
    "table": {"type": "string"}, "rows": {"type": "integer"}, "columns": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "description": "sha256 over the canonically sorted rows; order-independent."},
    "created": {"type": "string", "format": "date-time"}
  }
}
